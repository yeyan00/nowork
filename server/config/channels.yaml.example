# Channel 频道配置示例
# 复制此文件为 channels.yaml 并填入真实凭据
# channels.yaml 已加入 .gitignore，不会上传

channels:
  # ── 钉钉 ──────────────────────────────────
  - id: my-dingtalk
    platform: dingtalk
    name: 我的钉钉机器人
    enabled: false
    worker_id: ""            # ⚠️ 必填：绑定的 Worker ID
    config:
      client_id: ""          # ⚠️ 必填
      client_secret: ""      # ⚠️ 必填
      robot_code: ""         # 可选
      message_type: markdown # markdown | text

  # ── 飞书 ──────────────────────────────────
  - id: my-feishu
    platform: feishu
    name: 我的飞书机器人
    enabled: false
    worker_id: ""            # ⚠️ 必填
    config:
      app_id: ""             # ⚠️ 必填
      app_secret: ""         # ⚠️ 必填
      encrypt_key: ""        # 可选
      verification_token: "" # 可选
      domain: feishu         # feishu | lark

  # ── 企业微信 ──────────────────────────────
  # - id: my-wecom
  #   platform: wecom
  #   name: 我的企微机器人
  #   enabled: false
  #   worker_id: ""
  #   config:
  #     bot_id: ""
  #     secret: ""
