{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nowork",
  "version": "0.1.0",
  "identifier": "com.nowork.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": [
      {
        "title": "nowork",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/python",
      "resources/server",
      "resources/runtime"
    ]
  }
}
